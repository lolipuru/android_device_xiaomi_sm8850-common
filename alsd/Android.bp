cc_binary {
    name: "alsd",
    vendor: true,
    relative_install_path: "hw",
    srcs: ["alsd.cpp"],
    shared_libs: [
        "libbinder_ndk",
        "liblog",
        "vendor.xiaomi.sensor.citsensorservice-V1-ndk",
    ],
    init_rc: ["alsd.rc"],
}
