cc_binary {
    name: "sensor-notifier",
    vendor: true,
    init_rc: ["sensor-notifier.rc"],
    srcs: [
        "AodNotifier.cpp",
        "main.cpp",
        "SensorNotifier.cpp",
    ],
    shared_libs: [
        "android.frameworks.sensorservice-V1-ndk",
        "android.hardware.sensors-V3-ndk",
        "libbase",
        "libbinder_ndk",
    ],
}
